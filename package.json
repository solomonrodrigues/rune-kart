{
  "name": "rune-kart",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "test": "npm test -w shared"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
