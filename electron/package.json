{
  "name": "rune-kart-desktop",
  "productName": "Rune Kart",
  "version": "0.1.0",
  "private": true,
  "description": "Rune Kart desktop app: host a LAN race or join one",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "dev.runekart.desktop",
    "productName": "Rune Kart",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.racing-games"
    },
    "dmg": {
      "artifactName": "RuneKart-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "RuneKart-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
